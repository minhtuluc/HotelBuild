# Pine Hill — biến môi trường cho phát triển local.
# Tạo bản dùng thật: cp .env.example .env   (.gitignore đã chặn .env và .env.*, chỉ cho phép .env.example)
# Không bao giờ commit bí mật thật vào repo (NFR-SEC-06).

# ── CSDL: hai URL, hai role (QĐ-02 mục 4) ─────────────────────────────────────
# Trùng với infra/docker-compose.yml; đổi ở đây nếu muốn mật khẩu dev khác.
POSTGRES_USER=pinehill
POSTGRES_PASSWORD=pinehill_dev
POSTGRES_DB=pinehill

# Role chủ sở hữu: chỉ dùng cho migration/DDL (prisma migrate deploy, pnpm db:dev-roles).
DATABASE_MIGRATION_URL=postgresql://pinehill:pinehill_dev@127.0.0.1:5432/pinehill

# Role runtime app_rw: do migration baseline (HB-005) tạo, mật khẩu đặt bằng pnpm db:dev-roles.
# Đến khi HB-005 chạy xong thì URL này chưa đăng nhập được — đây là giá trị mẫu.
DATABASE_URL=postgresql://app_rw:app_rw_dev@127.0.0.1:5432/pinehill

# ── Redis 7: cache, khoá phân tán, idempotency (ADR-004) ──────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Mailpit local: SMTP giả, hộp thư ở http://127.0.0.1:8025 ──────────────────
SMTP_URL=smtp://127.0.0.1:1025
# API gửi thư đặt lại mật khẩu khách (HB-028); production bắt buộc đặt SMTP_FROM.
SMTP_FROM="Pine Hill <no-reply@localhost>"
# Gốc customer web để dựng link <gốc>/account/reset-password?token=…
GUEST_WEB_BASE_URL=http://127.0.0.1:3001

# ── Nghiệp vụ & quan sát ──────────────────────────────────────────────────────
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
IDEMPOTENCY_TTL_HOURS=24
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1

# ── BẮT BUỘC, sinh ngẫu nhiên khi tạo .env — để trống ở tệp mẫu ───────────────
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Hai web + hai Android (kiến trúc §7.1) ────────────────────────────────────
# API :3000 · customer-web :3001 · operations-web :3002
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api/v1
EXPO_PUBLIC_APP_VARIANT=development

# ── Cổng thanh toán / OTA / thông báo: mở khi tích hợp thật, mặc định trỏ bộ mô phỏng ──
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# OTA_BOOKING_BASE_URL=
# OTA_BOOKING_API_KEY=
# OTA_AGODA_BASE_URL=
# OTA_AGODA_API_KEY=
# OTA_AIRBNB_BASE_URL=
# OTA_AIRBNB_API_KEY=
# OTA_SIMULATION=true
# ── Kênh thông báo (HB-168) ───────────────────────────────────────────────────
# EMAIL dùng SMTP thật; SMS/ZALO_OA/PUSH là adapter giả lập cho tới khi có nhà cung cấp nên KHÔNG có biến.
# Thiếu hai biến dưới ⇒ kênh EMAIL lỗi `EMAIL_NOT_CONFIGURED` (không giả vờ đã gửi).
NOTI_SMTP_URL=
NOTI_SMTP_FROM=

# ── Tệp xuất tạm (HB-163) ─────────────────────────────────────────────────────
# Worker ghi tệp báo cáo, API đọc để phục vụ link tải có hạn. Bỏ trống ⇒ <tmpdir>/pinehill-exports.
# Hai tiến trình PHẢI dùng cùng giá trị (cùng máy hoặc cùng ổ đĩa chia sẻ).
EXPORT_DIR=
