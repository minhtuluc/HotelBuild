# Mẫu `.env` cho VPS (HB-175, QĐ-08). Sao thành `infra/prod/.env` TRÊN VPS, quyền 600, không commit.
# Sinh bí mật: openssl rand -base64 48   (mật khẩu DB/Redis: openssl rand -hex 24 — tránh ký tự cần escape trong URL)

# ── Tên miền (DNS A/AAAA trỏ về VPS). Staging local: api.localhost / ops.localhost / book.localhost
API_HOST=api.example.com
OPS_HOST=ops.example.com
CUSTOMER_HOST=book.example.com
# production: "email ops@example.com"  ·  staging local: "local_certs"
CADDY_GLOBAL_OPTIONS=email ops@example.com
# Chỉ staging local (local_certs): /extra-ca/root.crt  (chép CA của Caddy vào infra/prod/ca/, xem README)
WEB_EXTRA_CA_CERTS=

# ── Image (HB-177: GHCR gắn SHA). Để trống ⇒ build tại chỗ, tag `local`.
IMAGE_REGISTRY=pinehill
IMAGE_TAG=local

# ── PostgreSQL / Redis (chỉ trong mạng nội bộ compose)
POSTGRES_USER=pinehill
POSTGRES_DB=pinehill
POSTGRES_PASSWORD=
APP_RW_PASSWORD=
REDIS_PASSWORD=

# ── Bí mật ứng dụng
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Tuỳ chọn
LOG_LEVEL=info
SMTP_URL=
SMTP_FROM=
NOTI_SMTP_URL=
NOTI_SMTP_FROM=
OTEL_EXPORTER_OTLP_ENDPOINT=
FRONT_DESK_CONTACT=
# ── PSP (BẮT BUỘC). Production từ chối khởi động nếu thiếu: khoá mô phỏng là hằng công khai trong mã
#    (ai cũng giả được giao dịch). Staging chưa có tài khoản sandbox: điền chuỗi ngẫu nhiên — API chạy,
#    nhưng thanh toán online sẽ không hoàn tất (thu tại quầy vẫn dùng được).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# ── Sao lưu PostgreSQL (HB-179, BẮT BUỘC). Kho S3-compatible ở nhà cung cấp/vùng KHÁC VPS; bucket tạo trước,
#    khoá truy cập chỉ cho bucket này. Runbook: docs/07-ban-giao/van-hanh/sao-luu-phuc-hoi.md
BACKUP_S3_ENDPOINT=s3.example-provider.com
BACKUP_S3_PORT=443
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PATH=/pinehill
BACKUP_S3_KEY=
BACKUP_S3_KEY_SECRET=
# host (AWS/đa số nhà cung cấp) | path (SeaweedFS/MinIO tự dựng)
BACKUP_S3_URI_STYLE=host
BACKUP_S3_VERIFY_TLS=y
# openssl rand -base64 48 — MẤT KHOÁ NÀY LÀ MẤT MỌI BẢN SAO LƯU: cất ít nhất 2 nơi ngoài VPS
BACKUP_CIPHER_PASS=
BACKUP_RETENTION_FULL=14
# 19:00 UTC = 02:00 giờ VN
BACKUP_FULL_AT_UTC=19:00
