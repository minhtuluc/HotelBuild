# Expo/Metro cần layout node_modules phẳng (tài liệu Expo khuyến nghị cho pnpm).
node-linker=hoisted

# Peer không khớp giữa React Native/Expo không được làm đỏ CI cài đặt.
strict-peer-dependencies=false

# Không tự chạy script cài đặt của dependency ngoài danh sách cho phép (NFR-SEC-06).
enable-pre-post-scripts=false
