{
  "name": "@pinehill/domain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pure domain foundation. exports điều kiện: cờ `pinehill-dist` → dist/ (runtime Node trong image api/worker); mặc định → src TS cho typecheck/dev.",
  "exports": {
    ".": {
      "pinehill-dist": "./dist/index.js",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./inventory": {
      "pinehill-dist": "./dist/inventory/index.js",
      "types": "./src/inventory/index.ts",
      "default": "./src/inventory/index.ts"
    },
    "./pricing": {
      "pinehill-dist": "./dist/pricing/index.js",
      "types": "./src/pricing/index.ts",
      "default": "./src/pricing/index.ts"
    },
    "./cancellation": {
      "pinehill-dist": "./dist/cancellation/index.js",
      "types": "./src/cancellation/index.ts",
      "default": "./src/cancellation/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7",
    "fast-check": "^4.3.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "@types/eslint": "^9.6.1"
  }
}
