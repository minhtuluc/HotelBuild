{
  "name": "@pinehill/i18n",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ngôn ngữ dùng chung cho web khách và app Android: danh sách locale, định dạng tiền/ngày/giờ VN theo locale (HB-275).",
