    "test:coverage": "vitest run --coverage",
    "openapi:generate": "tsx src/openapi/generate.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
