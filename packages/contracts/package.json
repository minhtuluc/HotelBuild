{
  "name": "@pinehill/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hợp đồng API: zod schema, mã lỗi E_*, OpenAPI 3.1 sinh tự động",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
