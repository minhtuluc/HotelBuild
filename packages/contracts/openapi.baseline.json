    "/api/v1/users/{userId}/access": {
      "put": {
        "operationId": "usersAccessUpdate",
        "summary": "Gán vai trò/phạm vi cơ sở/trạng thái người dùng (UC-AUTH-02, BR-RBAC-01/02)",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Bắt buộc cho mọi lệnh ghi; hiệu lực 24 giờ (api.md §1.3)."
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Mã tương quan do client sinh; server tự sinh nếu thiếu (kiến trúc §9)."
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Phiên bản cấu hình; thiếu → 428, lệch → 412 (api.md §1.6)."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "OWNER",
                      "MANAGER",
                      "FRONT_DESK",
                      "RESERVATION_AGENT",
                      "ACCOUNTANT",
                      "HOUSEKEEPING",
                      "SYSADMIN"
                    ]
                  },
                  "propertyScope": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "isActive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "role",
                  "propertyScope",
                  "isActive"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Người dùng đã cập nhật"
          },
          "403": {
            "description": "E_RBAC_FORBIDDEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "E_GEN_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "412": {
            "description": "E_GEN_VERSION_CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "428": {
            "description": "E_GEN_PRECONDITION_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/health": {
      "get": {
        "operationId": "systemHealth",
        "summary": "Kiểm tra sống; chỉ trả {status:\"ok\"} (api.md §2, SYS)",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Dịch vụ sống"
          },
          "503": {
            "description": "E_GEN_SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
