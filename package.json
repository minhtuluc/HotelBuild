{
  "name": "pine-hill-ooad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pine Hill — workspace thi công (API/worker + 4 frontend) và công cụ kiểm tài liệu OOAD",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.34.5",
  "prettier": "@pinehill/config/prettier.json",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "@nestjs/platform-fastify@11.2.7>fastify": "5.12.5",
      "next@15.5.26>postcss": "8.5.28",
      "@prisma/config@6.19.3>deepmerge-ts": "8.0.2",
      "source-map-js@<1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5",
      "shell-quote@>=1.8.4 <1.11.0": "1.11.0",
      "vitest@3.2.7>tinypool": "2.1.2"
    }
  },
  "scripts": {
    "check": "npm run check:docs && npm test",
    "check:docs": "npm run check:links && npm run check:mermaid && npm run check:ids",
    "check:links": "node scripts/check-links.mjs",
    "check:mermaid": "node scripts/check-mermaid.mjs",
    "check:ids": "node scripts/check-ids.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "pr:merge": "node scripts/merge-pr.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "extract:sql": "node scripts/extract-sql.mjs",
    "test": "npm run test:tooling && npm run test:db",
    "test:tooling": "node --test tests/tooling.test.mjs tests/agent-qc.test.mjs tests/scope.test.mjs",
    "test:db": "node --test --test-concurrency=1 tests/database.test.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mjs,js,json,css}\" \"packages/**/*.{ts,tsx,mjs,js,json}\"",
    "products:test": "pnpm -r --workspace-concurrency=1 test",
    "test:integration": "pnpm --filter @pinehill/api test:integration && pnpm --filter @pinehill/worker test:integration",
    "products:test:coverage": "pnpm -r --workspace-concurrency=1 test:coverage",
    "products:build": "pnpm -r build",
    "openapi:generate": "pnpm --filter @pinehill/contracts openapi:generate",
    "check:openapi": "node scripts/check-openapi-drift.mjs",
    "check:imports": "node scripts/check-frontend-imports.mjs",
    "ci": "pnpm check:scope && pnpm check:openapi && pnpm check:contract && pnpm check:imports && pnpm check:dependency-security && pnpm typecheck && pnpm typecheck:e2e && pnpm lint && pnpm format:check && pnpm products:test:coverage && pnpm products:build",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "openapi:baseline": "node scripts/set-openapi-baseline.mjs",
    "check:contract": "node scripts/check-openapi-breaking.mjs",
    "db:dev-roles": "node apps/api/prisma/dev-roles.mjs",
    "migrate": "node scripts/migrate.mjs",
    "db:seed": "pnpm --filter @pinehill/api db:seed",
    "owner:bootstrap": "pnpm --filter @pinehill/api owner:bootstrap",
    "db:drift": "node apps/api/prisma/drift.mjs",
    "check:dependency-security": "node --test infra/security/dependency-regression.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.3.14",
    "@pinehill/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "github-slugger": "^2.0.0",
    "jsdom": "^26.1.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.0",
    "pg": "^8.16.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
