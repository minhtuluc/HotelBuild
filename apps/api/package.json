{
  "name": "@pinehill/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API dùng chung — NestJS 11 + Fastify (Pine Hill)",
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --conditions=pinehill-dist dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --no-file-parallelism",
    "test:integration": "node ../../scripts/test-integration.mjs api",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed/index.ts",
    "owner:bootstrap": "tsx src/cli/bootstrap-owner.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@node-rs/argon2": "^2.2.1",
    "@pinehill/contracts": "workspace:*",
    "@pinehill/domain": "workspace:*",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.5",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "prisma": "6.19.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
