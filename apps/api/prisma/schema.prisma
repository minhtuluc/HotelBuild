generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chain_seq   BigInt   @unique
  actor_id    String?  @db.Uuid
  actor_role  String
  action      String
  entity_type String
  entity_id   String?  @db.Uuid
  before_json Json?
  after_json  Json?
  reason      String?
  ip_address  String?  @db.Inet
  at          DateTime @default(now()) @db.Timestamptz(6)
  prev_hash   String?
  row_hash    String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [actor_id], references: [id], onUpdate: NoAction)

  @@index([actor_id, at(sort: Desc)], map: "idx_audit_logs_actor")
  @@index([entity_type, entity_id, at(sort: Desc)], map: "idx_audit_logs_entity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model booking_charges {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id          String                @db.Uuid
  booking_room_id     String?               @db.Uuid
  stay_date           DateTime?             @db.Date
  kind                String
  source_key          String
  amount              BigInt
  voided_amount       BigInt                @default(0)
  reason              String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  bookings            bookings              @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  booking_rooms       booking_rooms?        @relation(fields: [booking_room_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment_allocations payment_allocations[]

  @@unique([booking_id, source_key])
  @@index([booking_id], map: "idx_booking_charges_booking")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model booking_rooms {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id       String             @db.Uuid
  room_type_id     String             @db.Uuid
  adults           Int                @db.SmallInt
  children         Int                @default(0) @db.SmallInt
  price_per_night  BigInt
  status           String             @default("ACTIVE")
  cancelled_at     DateTime?          @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  booking_charges  booking_charges[]
  bookings         bookings           @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room_types       room_types         @relation(fields: [room_type_id], references: [id], onUpdate: NoAction)
  room_assignments room_assignments[]
  room_moves       room_moves[]
}

model booking_status_history {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id  String   @db.Uuid
  from_status String?
  to_status   String
  reason      String?
  actor_id    String?  @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [actor_id], references: [id], onUpdate: NoAction)
  bookings    bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id                                                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                                                   String                   @unique
  seq                                                    BigInt                   @unique @default(autoincrement())
  guest_id                                               String                   @db.Uuid
  property_id                                            String                   @db.Uuid
  room_type_id                                           String                   @db.Uuid
  rate_plan_id                                           String                   @db.Uuid
  channel_id                                             String                   @db.Uuid
  check_in                                               DateTime                 @db.Date
  check_out                                              DateTime                 @db.Date
  nights                                                 Int?                     @default(dbgenerated("((check_out - check_in))::smallint")) @db.SmallInt
  adults                                                 Int                      @db.SmallInt
  children                                               Int                      @default(0) @db.SmallInt
  status                                                 String                   @default("DRAFT")
  room_count                                             Int                      @default(1) @db.SmallInt
  total_amount                                           BigInt                   @default(0)
  deposit_percent                                        Decimal                  @db.Decimal(5, 2)
  deposit_amount                                         BigInt                   @default(0)
  paid_amount                                            BigInt                   @default(0)
  refunded_amount                                        BigInt                   @default(0)
  penalty_amount                                         BigInt                   @default(0)
  balance_due                                            BigInt                   @default(0)
  currency                                               String                   @default("VND") @db.Char(3)
  hold_expires_at                                        DateTime?                @db.Timestamptz(6)
  oversold                                               Boolean                  @default(false)
  duplicate_suspected                                    Boolean                  @default(false)
  price_locked                                           Boolean                  @default(false)
  external_ref                                           String?
  channel_policy_code                                    String?
  reschedule_count                                       Int                      @default(0) @db.SmallInt
  note                                                   String?
  created_by                                             String?                  @db.Uuid
  created_at                                             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime                 @default(now()) @db.Timestamptz(6)
  cancelled_at                                           DateTime?                @db.Timestamptz(6)
  cancel_reason                                          String?
  version                                                BigInt                   @default(1)
  booking_charges                                        booking_charges[]
  booking_rooms                                          booking_rooms[]
  booking_status_history                                 booking_status_history[]
  channels                                               channels                 @relation(fields: [channel_id], references: [id], onUpdate: NoAction)
  users                                                  users?                   @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  guests                                                 guests                   @relation(fields: [guest_id], references: [id], onUpdate: NoAction)
  properties                                             properties               @relation(fields: [property_id], references: [id], onUpdate: NoAction)
  rate_plans                                             rate_plans               @relation(fields: [rate_plan_id], references: [id], onUpdate: NoAction)
  room_types                                             room_types               @relation(fields: [room_type_id], references: [id], onUpdate: NoAction)
  loyalty_transactions                                   loyalty_transactions[]
  notifications                                          notifications[]
  payments                                               payments[]
  price_snapshots                                        price_snapshots[]
  refund_requests                                        refund_requests[]
  room_merges_room_merges_primary_booking_idTobookings   room_merges[]            @relation("room_merges_primary_booking_idTobookings")
  room_merges_room_merges_secondary_booking_idTobookings room_merges[]            @relation("room_merges_secondary_booking_idTobookings")
  room_moves                                             room_moves[]

  @@index([guest_id, created_at(sort: Desc)], map: "idx_bookings_guest_created")
  @@index([property_id, check_in], map: "idx_bookings_property_checkin")
}

