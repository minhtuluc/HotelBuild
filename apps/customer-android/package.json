{
  "name": "@pinehill/customer-android",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Customer Android — cùng journey khách trên Android, kho lưu trữ bảo mật và deep link PSP",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "expo export --platform android --output-dir dist --max-workers 2 && node ../../scripts/check-android-hermes.mjs dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.18",
    "@pinehill/api-client": "workspace:*",
    "@pinehill/contracts": "workspace:*",
    "@pinehill/i18n": "workspace:*",
    "@pinehill/ui-native": "workspace:*",
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "^57.0.33",
    "expo-crypto": "~57.0.4",
    "expo-router": "^57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "babel-preset-expo": "^57.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
